# ==========================================
# CampusHub Environment Variables Template
# ==========================================
# Copy this file to .env.local and populate the values for local development.
# Do NOT commit real credentials or .env.local to version control.

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Public client credentials (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only privileged key (NEVER expose to browser client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# PayPal Integration (Sandbox)
# ------------------------------------------
# Server-only privileged sandbox credentials
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Public client ID for browser SDK (client secret must NEVER be exposed here)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id

# ------------------------------------------
# AI Provider Integration — Astropods AI Gateway
# ------------------------------------------
# Server-only API key for Astropods managed model gateway
ASTROPODS_API_KEY=your-astropods-api-key
ASTROPODS_BASE_URL=https://gateway.astropods.com/v1
ASTROPODS_MODEL=gpt-4o

# Astropods Agent OS alternative platform-injected variables (optional)
# ASTRO_GATEWAY_API_KEY=your-astro-gateway-key
# ASTRO_GATEWAY_URL=https://gateway.astropods.com/v1

# Legacy AI key compatibility
AI_API_KEY=your-ai-api-key

