# CampusHub 2.0 — environment template
# Copy to .env.local for dev. On Render, set via dashboard (render.yaml declares them).

# --- Database (required; app will not run without it) ---
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Auth.js (required; signs the encrypted session cookie) ---
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- PayPal (required for storefront checkout; guest checkout enabled) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=MYR
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Astropods Autonomous Commerce Analyst (Exclusive AI Engine) ---
# When deployed via `ast deploy`, set the agent URL.
# If unset, CampusHub runs the Astropods Analyst Agent locally against your Postgres metrics pack.
ASTROPODS_AGENT_URL=
ASTROPODS_API_KEY=

# Bearer tokens accepted by /api/insights/pack for machine agents (Astropods
# analyst). Comma-separated; each token is org-bound (demo org). Generate:
#   openssl rand -hex 32
PACK_API_TOKENS=

# --- Commercial & Venue Integrations (optional) ---
# Channel3 commercial product index & market intelligence radar
CHANNEL3_API_KEY=
# Bryntum Scheduler commercial license key (runs in Community MIT mode if unset)
BRYNTUM_LICENSE_KEY=

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
