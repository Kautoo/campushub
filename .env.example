# CampusHub 2.0 — environment template
# Production domain: https://campushub.hyria.top
# Copy to .env.local for local dev. On Render/Vercel/Docker, set via dashboard.

# --- Database (required; app will not run without it) ---
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Auth.js (required; signs the encrypted session cookie) ---
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://campushub.hyria.top

# --- PayPal Orders v2 (exclusive checkout engine with instant simulation fallback) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=MYR
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Production Webhook Endpoint: https://campushub.hyria.top/api/paypal/webhook

# --- Astropods Autonomous Commerce Analyst (Exclusive Grounded AI Engine) ---
# When deployed via `ast deploy`, set the remote agent URL.
# If unset, CampusHub connects to the local embedded Astropods agent against your Postgres metrics pack.
ASTROPODS_AGENT_URL=
ASTROPODS_API_KEY=

# Bearer tokens accepted by /api/insights/pack for machine agents (Astropods analyst).
# Comma-separated; each token is org-bound. Generate: openssl rand -hex 32
PACK_API_TOKENS=

# --- Commercial & Venue Integrations (optional) ---
# Channel3 commercial product index & market price comparison radar
CHANNEL3_API_KEY=
# Bryntum Scheduler commercial license key (runs in Community MIT mode if unset)
BRYNTUM_LICENSE_KEY=

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=https://campushub.hyria.top
