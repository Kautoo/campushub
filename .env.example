# CampusHub 2.0 — environment template
# Copy to .env.local for dev. On Render, set via dashboard (render.yaml declares them).

# --- Database (required; app will not run without it) ---
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Auth.js (required; signs the encrypted session cookie) ---
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- PayPal (required for storefront checkout; hidden with notice if absent) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=MYR
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- AI gateway (optional; OpenAI-compatible. Without keys: setup notice, no fabrication) ---
AI_BASE_URL=
AI_API_KEY=
# Bearer tokens accepted by /api/insights/pack for machine agents (Astropods
# analyst). Comma-separated; each token is org-bound (demo org). Generate:
#   openssl rand -hex 32
PACK_API_TOKENS=
AI_MODEL=glm-5.3-flash

# --- Sponsors (optional; widgets hidden/disabled without keys) ---
CHANNEL3_API_KEY=
ASTROPODS_API_KEY=
BRYNTUM_LICENSE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
