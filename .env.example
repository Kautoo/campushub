# ==========================================
# CampusHub Environment Variables Template
# ==========================================
# Copy this file to .env.local and populate the values for local development.
# Do NOT commit real credentials or .env.local to version control.

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Public client credentials (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only privileged key (NEVER expose to browser client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# PayPal Integration (Planned)
# ------------------------------------------
# Sandbox credentials for upcoming payment phase
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ------------------------------------------
# AI Provider Integration (Planned)
# ------------------------------------------
# Server-only API key for upcoming AI assistance phase
AI_API_KEY=your-ai-api-key

