# CampusHub 2.0 — environment template
# Copy to .env.local for dev. On Render, set via dashboard (render.yaml declares them).

# --- Supabase (required; app will not run without these) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- PayPal (required for storefront checkout; hidden with notice if absent) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=MYR
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- AI gateway (optional; OpenAI-compatible. Without keys: setup notice, no fabrication) ---
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=glm-5.3-flash

# --- Sponsors (optional; widgets hidden/disabled without keys) ---
CHANNEL3_API_KEY=
ASTROPODS_API_KEY=
BRYNTUM_LICENSE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
